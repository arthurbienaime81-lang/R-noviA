NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Optionnel : adresse d'expédition des emails (par défaut, l'adresse de test
# Resend "onboarding@resend.dev", qui ne nécessite pas de domaine vérifié).
# Le nom affiché à l'expéditeur est toujours remplacé par le nom de
# l'entreprise TCE pour les emails vus par le client — seule l'adresse
# ci-dessous (partie après le <...>) est réellement utilisée.
# EMAIL_FROM="RenovIA <contact@votredomaine.fr>"

# Optionnel : jeton partagé pour appeler /api/cron/relances depuis un
# scheduler externe (Vercel Cron, cron-job.org...) via
# "Authorization: Bearer <CRON_SECRET>". Sans cette variable, la route reste
# appelable uniquement par une entreprise connectée (bouton "Vérifier les
# relances" du tableau de bord).
# CRON_SECRET=
